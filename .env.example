# Web
# Leave VITE_API_BASE_URL empty to run the local demo.
# Set it only after you install HTTP adapters. See examples/api-integration.
VITE_API_BASE_URL=
VITE_APP_NAME=Tampletgrok
WEB_PORT=5173

# Mobile
# Leave EXPO_PUBLIC_API_URL empty to run the local demo.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_APP_NAME=Tampletgrok
EXPO_PUBLIC_IOS_BUNDLE_ID=com.tampletgrok.app
EXPO_PUBLIC_ANDROID_PACKAGE=com.tampletgrok.app
EXPO_PUBLIC_URL_SCHEME=tampletgrok
